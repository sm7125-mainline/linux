/*
 * SM7125 Samsung Galaxy Tab S6 Lite (2022) (gta4xlve) device tree
 */

/dts-v1/;

#include "sm7125-samsung-common.dtsi"

/ {
	model = "Samsung Galaxy Tab S6 Lite (2022)";
	compatible = "samsung,gta4xlve", "qcom,sm7125";
	qcom,board-id = <0x22 0x5>;

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		rmtfs_mem: memory@f3700000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0 0xf3700000 0 0x202000>;
			qcom,use-guard-pages;
			no-map;

			qcom,client-id = <1>;
			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
		};
	};
};

&bluetooth {
	firmware-name = "sm7125/gta4xlve/apnv11.bin";
};

&display_panel {
	compatible = "tianma,fhd-video";
	status = "okay";
};

&gpu_zap_shader {
	firmware-name = "qcom/sm7125/gta4xlve/a615_zap.mbn";
};

&ipa {
	status = "okay";
	firmware-name = "qcom/sm7125/gta4xlve/ipa_fws.mbn";
};

&remoteproc_adsp {
	status = "okay";
	firmware-name = "qcom/sm7125/gta4xlve/adsp.mbn";
};

&remoteproc_cdsp {
	status = "okay";
	firmware-name = "qcom/sm7125/gta4xlve/cdsp.mbn";
};

&sound {
	model = "Galaxy Tab S6 Lite";
};
